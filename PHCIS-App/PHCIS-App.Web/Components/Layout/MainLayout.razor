@inherits LayoutComponentBase
@using MudBlazor
@inject NavigationManager NavManager

<MudThemeProvider Theme="_hospitalTheme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>

    <!-- TOP APP BAR -->
    <MudAppBar Elevation="3" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />

        <MudText Typo="Typo.h6" Class="ml-2">
            PHCIS • Hospital Administration
        </MudText>

        <MudSpacer />

        <!-- User Section -->
        <MudMenu AnchorOrigin="Origin.BottomCenter">
            <ActivatorContent>
                <MudButton StartIcon="@Icons.Material.Filled.AccountCircle"
                           Variant="Variant.Text"
                           Color="Color.Inherit">
                    Admin User
                </MudButton>
            </ActivatorContent>

@*          <MudMenuItem OnClick="GoToProfile">
    Profile
</MudMenuItem>

<MudMenuItem OnClick="GoToLogout">
    Logout
</MudMenuItem> *@

        </MudMenu>
    </MudAppBar>

    <!-- SIDE DRAWER -->
    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="4"
               Variant="DrawerVariant.Responsive"
               ClipMode="DrawerClipMode.Always"
               Class="d-flex flex-column">

        <!-- HEADER -->
        <MudDrawerHeader Class="pa-4">
            <MudText Typo="Typo.h6" Color="Color.Primary">
                🏥 PHCIS System
            </MudText>
        </MudDrawerHeader>

        <MudDivider />

        <!-- NAVIGATION (TAKEN UP IMMEDIATELY UNDER HEADER) -->
        <MudNavMenu Dense="true" Class="flex-grow-1">

            <MudNavLink Href="login"
                        Icon="@Icons.Material.Filled.Dashboard"
                        Match="NavLinkMatch.All">
                Dashboard
            </MudNavLink>

            <MudNavLink Href="patient"
                        Icon="@Icons.Material.Filled.EventAvailable">
                Patient Appointments
            </MudNavLink>

            <MudNavLink Href="doctor"
                        Icon="@Icons.Material.Filled.MedicalServices">
                Doctor Appointments
            </MudNavLink>

            <MudNavLink Href="timeslots"
                        Icon="@Icons.Material.Filled.Schedule">
                Time Slots
            </MudNavLink>

        </MudNavMenu>

        <MudDivider />

        <!-- OPTIONAL FOOTER SECTION (STICKS TO BOTTOM) -->
        <div class="pa-3">
            <MudNavLink Href="logout"
                        Icon="@Icons.Material.Filled.Logout">
                Logout
            </MudNavLink>
        </div>

    </MudDrawer>

    <MudPopoverProvider/>

    <!-- MAIN CONTENT -->
    <MudMainContent Class="pa-6">
        @Body
    </MudMainContent>

</MudLayout>

@code {
    private bool _drawerOpen = true;

    void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void GoToProfile()
    {
        NavManager.NavigateTo("profile");
    }

    private void GoToLogout()
    {
        NavManager.NavigateTo("logout");
    }


    private MudTheme _hospitalTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#1565C0",        // Hospital Blue
            Secondary = "#00ACC1",      // Medical Teal
            Background = "#121826",
            Surface = "#1E293B",
            AppbarBackground = "#0F172A",
            DrawerBackground = "#111827",
            TextPrimary = "#FFFFFF",
            TextSecondary = "#94A3B8"
        }
    };
}


