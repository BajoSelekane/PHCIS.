@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_darkTheme" />
<MudLayout>

    <!-- Top App Bar -->
    <MudAppBar Elevation="4" Color="Color.Primary">
        <MudText Typo="Typo.h6" Class="ml-2">PHCIS-App</MudText>
        <MudSpacer />
    </MudAppBar>

    <!-- Sidebar Drawer -->
    <MudDrawer Elevation="6"
               Variant="DrawerVariant.Responsive"
               Open="true"
               ClipMode="DrawerClipMode.Always"
               Color="Color.Surface">

        <MudNavMenu Dense="true">

            <MudNavLink Href="login"
                        Icon="@Icons.Material.Filled.Home"
                        Match="NavLinkMatch.All">
                Home
            </MudNavLink>

            <AuthorizeView Roles="Admin,Doctor">
                <Authorized>
                    <MudNavLink Href="patient"
                                Icon="@Icons.Material.Filled.Event">
                        Patient Appointments
                    </MudNavLink>
                </Authorized>
            </AuthorizeView>

            <MudNavLink Href="login"
                        Icon="@Icons.Material.Filled.Login">
                Login
            </MudNavLink>

            <MudNavLink Href="register"
                        Icon="@Icons.Material.Filled.PersonAdd">
                Register
            </MudNavLink>

            <MudNavLink Href="doctor"
                        Icon="@Icons.Material.Filled.MedicalServices">
                Doctors Appointments
            </MudNavLink>

            <MudNavLink Href="timeslots"
                        Icon="@Icons.Material.Filled.Schedule">
                Search TimeSlots
            </MudNavLink>

        </MudNavMenu>
    </MudDrawer>

</MudLayout>

@code {
    private MudTheme _darkTheme = new MudTheme()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#00C2FF",
            Secondary = "#7C4DFF",
            Background = "#121212",
            Surface = "#1E1E1E",
            AppbarBackground = "#1A1A1A",
            DrawerBackground = "#181818",
            TextPrimary = "#FFFFFF",
            TextSecondary = "#B0B0B0"
        }
    };
}



