@inherits LayoutComponentBase
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PHCIS-App</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <AuthorizeView Roles="Admin,Doctor">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="patient">
                        <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Patient Appointments
                    </NavLink>
                </div>
            </Authorized>

        </AuthorizeView>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="register">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Register
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="doctor">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Doctors Appointments
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="timeslots">
                <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Search TimeSlots
            </NavLink>
        </div>

      
    </nav>
</div>


